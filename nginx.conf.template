# Rendered by the nginx image at startup (envsubst): ${API_URL} is the API's internal URL.
server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    server_tokens off;

    add_header Content-Security-Policy "default-src 'self'; img-src 'self' data: https://cdn.discordapp.com; style-src 'self'; script-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'" always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy same-origin always;

    # Only the dashboard routes are forwarded; the bot's /v1 API stays private.
    location /api/web/ {
        proxy_pass ${API_URL}/web/;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    location /api/ {
        return 404;
    }

    location /assets/ {
        expires 1y;
    }
    location / {
        try_files $uri /index.html;
        expires -1;
    }
}
