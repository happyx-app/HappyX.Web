# Rendered by the nginx image at startup (envsubst): ${API_URL} is the API's internal URL.

# Rate limits per visitor for the API. Logging in is rare, so it gets a tight limit; the rest
# of the dashboard loads a handful of requests per page.
limit_req_zone $binary_remote_addr zone=happyx_auth:1m rate=10r/m;
limit_req_zone $binary_remote_addr zone=happyx_api:10m rate=10r/s;

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    server_tokens off;

    # The HTTPS reverse proxy in front of this container sits on a private network. Trust its
    # X-Forwarded-For so the rate limits count visitors, not the proxy; a header sent from
    # anywhere else is ignored, so it can't be spoofed to dodge them.
    set_real_ip_from 10.0.0.0/8;
    set_real_ip_from 172.16.0.0/12;
    set_real_ip_from 192.168.0.0/16;
    set_real_ip_from 127.0.0.0/8;
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;
    limit_req_status 429;

    add_header Content-Security-Policy "default-src 'self'; img-src 'self' data: https://cdn.discordapp.com; style-src 'self'; script-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'" always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy same-origin always;
    # Browsers ignore it over plain HTTP, so local development is unaffected.
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    # Only the dashboard routes are forwarded; the bot's /v1 API stays private.
    location /api/web/auth/ {
        limit_req zone=happyx_auth burst=10 nodelay;
        proxy_pass ${API_URL}/web/auth/;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    location /api/web/ {
        limit_req zone=happyx_api burst=40 nodelay;
        proxy_pass ${API_URL}/web/;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    location /api/ {
        return 404;
    }

    location /assets/ {
        expires 1y;
    }
    location / {
        try_files $uri /index.html;
        expires -1;
    }
}
